#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "quant.glsl"

// A batch of embedding rows, dequantized from pinned host memory: y[t][i] = dq(rows[t], i),
// where `rows` holds each token's row address as a u64. Workgroup y is the token. Elementwise; its twin is
// qwen36::quant::dequant_row, row by row.
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer U64s { uint64_t v[]; };

layout(local_size_x = 256) in;
layout(push_constant) uniform Push {
    uint64_t rows;
    uint64_t y;
    uint n;
    uint wtype;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x, tok = gl_WorkGroupID.y;
    if (i < p.n) {
        F32s(p.y).v[tok * p.n + i] = dq(p.wtype, U64s(p.rows).v[tok], i);
    }
}
