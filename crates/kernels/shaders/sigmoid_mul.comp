#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Attention's output gate: y = a ⊙ sigmoid(g).
layout(local_size_x = 256) in;
layout(push_constant) uniform Push {
    uint64_t a;
    uint64_t g;
    uint64_t y;
    uint n;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) {
        F32s(p.y).v[i] = F32s(p.a).v[i] * sigmoid(F32s(p.g).v[i]);
    }
}
