#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "common.glsl"
#include "quant.glsl"
#include "slots.glsl"
#include "tree32.glsl"

// experts_down for up to 16 tokens, each routed expert's down matrix read once. `list` is moe_unique's: workgroup
// (x, u) computes a block of rows of the u-th distinct expert's down projection for every token that chose it.
// Token i's input is act[i][j] (act is [tokens][k][n_ff], j the choice of ids[i][0 .. k] naming the expert), which is
// not at a fixed stride from token to token; each token's value is experts_down's bit for bit, written to
// y[(i·k + j) · n_embd + row]. A workgroup with u >= count exits (the whole group). An unusable slot gives NaN and
// refuse(), as experts_down does; there is no CPU path (serve) here.
//
// Layout: experts_down's (kernels::dispatch::expert_rows), as experts_gate_up_tokens describes, and TOKENS
// (specialization constant 0) as there: the dispatch's token count for 2 to 5 tokens, MAX_TOKENS otherwise.
layout(constant_id = 0) const uint TOKENS = 16u;
const uint EXPERT_WAVES = 8u;
layout(local_size_x = 256) in;
layout(push_constant) uniform Push {
    uint64_t table;
    uint64_t ids;
    uint64_t list;
    uint64_t act;
    uint64_t y;
    uint64_t status;
    uint layer_base;
    uint n_ff;
    uint n_embd;
    uint down_type;
    uint down_off;
    uint layer;
    uint k;
    float zero; // +0.0, tree32's zero
} p;

// Token i's choice: the first of its k ids that names e (a token's ids are distinct).
uint choice_of(uint i, uint e) {
    uint j = 0u;
    while (j + 1u < p.k && uint(F32s(p.ids).v[i * p.k + j]) != e) {
        j++;
    }
    return j;
}

void main() {
    uint lane = gl_SubgroupInvocationID, wave = gl_SubgroupID;
    uint units = p.n_ff / 32u;
    uint lpr = units <= 16u ? 16u : 32u;
    uint rpw = 32u / lpr;
    uint vl = lane % lpr;
    uint row = gl_WorkGroupID.x * (EXPERT_WAVES * rpw) + wave * rpw + lane / lpr;
    U32s l = U32s(p.list);
    uint u = gl_WorkGroupID.y;
    if (u >= l.v[0]) {
        return;
    }
    uint e = l.v[1u + 2u * u], mask = l.v[2u + 2u * u];
    Slot s = slot_at(p.table, p.layer_base + e);
    // Token i's activation row, (i·k + j)·n_ff values into act.
    uint xo[TOKENS];
    [[unroll]] for (uint i = 0u; i < TOKENS; i++) {
        xo[i] = ((mask >> i) & 1u) != 0u ? (i * p.k + choice_of(i, e)) * p.n_ff : 0u;
    }
    precise float acc[TOKENS];
    [[unroll]] for (uint i = 0u; i < TOKENS; i++) {
        acc[i] = 0.0;
    }
    if (usable(s)) {
        // A row past the end reads the last row and is never written: every lane reaches the shuffles.
        uint64_t dr = s.addr + uint64_t(p.down_off) +
                      uint64_t(min(row, p.n_embd - 1u)) * uint64_t(row_bytes(p.down_type, p.n_ff));
        if (p.down_type == T_Q5_K) {
            for (uint q = vl; q < units; q += 32u) {
                KQ w = kq_load(T_Q5_K, dr, q);
                [[unroll]] for (uint i = 0u; i < TOKENS; i++) {
                    if (((mask >> i) & 1u) != 0u) {
                        acc[i] += kq_dot(T_Q5_K, w, q, p.act + uint64_t(4u * xo[i]));
                    }
                }
            }
        } else {
            for (uint q = vl; q < units; q += 32u) {
                float wv[32];
                float c0, c1, c2;
                unit_load(p.down_type, dr, q, wv, c0, c1, c2);
                [[unroll]] for (uint i = 0u; i < TOKENS; i++) {
                    if (((mask >> i) & 1u) != 0u) {
                        acc[i] += unit_dot_loaded(p.down_type, wv, c0, c1, c2,
                                                  p.act + uint64_t(4u * (xo[i] + 32u * q)));
                    }
                }
            }
        }
    }
    [[unroll]] for (uint i = 0u; i < TOKENS; i++) {
        if (((mask >> i) & 1u) != 0u) {
            float total = tree32(acc[i], lpr, p.zero);
            if (vl == 0u && row < p.n_embd) {
                uint at = (i * p.k + choice_of(i, e)) * p.n_embd + row;
                if (!usable(s)) {
                    refuse(p.status, s, p.layer, e);
                    F32s(p.y).v[at] = uintBitsToFloat(0x7FC00000u);
                } else {
                    F32s(p.y).v[at] = total;
                }
            }
        }
    }
}
