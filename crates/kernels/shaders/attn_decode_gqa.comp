#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#include "common.glsl"

// attn_decode for long contexts: workgroup (s, kvh) covers cached positions [256s, 256s + 256)
// for every query head that reads KV head kvh (heads kvh·group .. kvh·group + group), so each cached K and V row is
// read once rather than once per query head. Every head's arithmetic is written operation for operation like
// attn_decode's. Neither kernel's sums are `precise`, so the same bits also rest on the compiler and driver
// contracting acc += a·b alike in both: the_gqa_attention_writes_attn_decodes_bits (test 1's block) is what pins them
// on this driver. Position 256s + j is scored for head g as (Σ_i k_i·q_i, i in order)·scale, by thread 32g + (j % 32)
// as K goes by in tiles of 32 positions (each tile read 256 contiguous bytes per 16 lanes and staged in shared
// memory); the chunk's max m and l = Σ exp(score − m) come from the same trees as reduce.glsl's red_max and red_sum
// (lane pairs halving their stride from 128), the group's heads side by side; then thread d sums
// exp(score_j − m)·v_j[d] over the chunk's positions in order. Writes attn_decode's partials, [m, l, acc[0..hd]] per
// (head, chunk), for attn_combine. group is at most GMAX and hd a multiple of 32 and at most 256 (dispatch.rs checks
// both); heads past group compute on zero queries and write nothing. The tiles' thread map needs 256 = 32·GMAX.
#define GMAX 8u
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Halves8 { uvec4 v[]; };

layout(local_size_x = 256) in;
// Nonzero skips the V pass (the partials' acc stays zero): a timing-only build, for attn_decode_speed's K-pass
// figure. The engine builds the default, 0.
layout(constant_id = 0) const uint K_ONLY = 0u;
layout(push_constant) uniform Push {
    uint64_t q;
    uint64_t kc;
    uint64_t vc;
    uint64_t part;
    uint n_ctx;
    uint hd;
    uint group;
    uint kv_width;
    uint n_split;
    float scale;
} p;

// Head g's 256 values at qw[256g ..]: the group's queries, then the scores and the trees, then the chunk's weights
// exp(score − m). kt holds one K tile: 32 positions × 128 values of f16, 16 bytes a slot, slot c of position r at
// 16r + (c ^ (r & 15)) so a wave reading one slot of 32 positions spreads over the banks. 8,192 + 8,192 = 16,384 bytes
// (ATTN_GQA_SHARED_BYTES in dispatch.rs), Vulkan's guarantee.
shared float qw[GMAX * 256];
shared uvec4 kt[512];

// a += k_i·q_g[i] for the 8 values of row chunk c (16 bytes, w), i in order: one head's share of attn_decode's dot.
void k_dot(uvec4 w, uint c, uint g, inout float a) {
    vec2 x = unpackHalf2x16(w.x), y = unpackHalf2x16(w.y), z = unpackHalf2x16(w.z), u = unpackHalf2x16(w.w);
    float kk[8] = float[8](x.x, x.y, y.x, y.y, z.x, z.y, u.x, u.y);
    [[unroll]] for (uint i = 0u; i < 8u; i++) {
        a += kk[i] * qw[g * 256u + 8u * c + i];
    }
}

// Thread t's two 16-byte slots of K tile n (positions 32·(n / nhalf) .., values 128·(n % nhalf) ..), read so that 16
// neighbouring lanes take 256 contiguous bytes of one position; zeros past the chunk's positions or the head.
void k_tile(uint n, uint nhalf, uint t0, uint nt, uint kvh, uint t, out uvec4 w[2]) {
    uint b = n / nhalf, hf = n % nhalf;
    [[unroll]] for (uint k = 0u; k < 2u; k++) {
        uint u = t + 256u * k, r = u >> 4u, c = u & 15u;
        uint row = 32u * b + r;
        w[k] = uvec4(0u);
        if (row < nt && 128u * hf + 8u * c < p.hd) {
            w[k] = Halves8(p.kc + uint64_t(2u * ((t0 + row) * p.kv_width + kvh * p.hd))).v[16u * hf + c];
        }
    }
}

void main() {
    uint s = gl_WorkGroupID.x, kvh = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
    uint h0 = kvh * p.group;
    uint t0 = 256u * s;
    uint nt = min(256u, p.n_ctx - t0);
    [[unroll]] for (uint g = 0u; g < GMAX; g++) {
        qw[g * 256u + t] = g < p.group && t < p.hd ? F32s(p.q).v[(h0 + g) * p.hd + t] : 0.0;
    }
    barrier();
    // The dot products go by K tiles of 32 positions: thread t = 32g + r takes position 32b + r of block b for head g,
    // the same chain of multiply-and-adds attn_decode's thread runs for that position and head. Each tile is loaded
    // into registers while the previous one is summed.
    uint r = t & 31u, gh = t >> 5u;
    uint nb = (nt + 31u) / 32u, nhalf = (p.hd + 127u) / 128u, ntile = nb * nhalf;
    uvec4 pre[2];
    k_tile(0u, nhalf, t0, nt, kvh, t, pre);
    uint n = 0u;
    float sb[8];
    [[unroll]] for (uint b = 0u; b < 8u; b++) {
        float a = 0.0;
        if (b < nb) {
            for (uint hf = 0u; hf < nhalf; hf++) {
                // Every thread is done with the last tile.
                barrier();
                [[unroll]] for (uint k = 0u; k < 2u; k++) {
                    uint u = t + 256u * k, rr = u >> 4u;
                    kt[16u * rr + ((u & 15u) ^ (rr & 15u))] = pre[k];
                }
                barrier();
                if (n + 1u < ntile) {
                    k_tile(n + 1u, nhalf, t0, nt, kvh, t, pre);
                }
                n++;
                uint nch = min(16u, (p.hd - 128u * hf) / 8u);
                [[unroll]] for (uint c = 0u; c < 16u; c++) {
                    if (c < nch) {
                        k_dot(kt[16u * r + (c ^ (r & 15u))], 16u * hf + c, gh, a);
                    }
                }
            }
        }
        sb[b] = a;
    }
    // Every thread is done with the queries: qw takes the scores, then thread t takes position t's.
    barrier();
    [[unroll]] for (uint b = 0u; b < 8u; b++) {
        uint row = 32u * b + r;
        qw[gh * 256u + row] = row < nt ? sb[b] * p.scale : neg_inf();
    }
    barrier();
    float sc[GMAX], m[GMAX], e[GMAX], l[GMAX];
    [[unroll]] for (uint g = 0u; g < GMAX; g++) {
        sc[g] = qw[g * 256u + t];
    }
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) {
            [[unroll]] for (uint g = 0u; g < GMAX; g++) {
                qw[g * 256u + t] = max(qw[g * 256u + t], qw[g * 256u + t + st]);
            }
        }
        barrier();
    }
    [[unroll]] for (uint g = 0u; g < GMAX; g++) {
        m[g] = qw[g * 256u];
    }
    barrier();
    [[unroll]] for (uint g = 0u; g < GMAX; g++) {
        e[g] = t < nt ? exp(sc[g] - m[g]) : 0.0;
        qw[g * 256u + t] = e[g];
    }
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) {
            [[unroll]] for (uint g = 0u; g < GMAX; g++) {
                qw[g * 256u + t] += qw[g * 256u + t + st];
            }
        }
        barrier();
    }
    [[unroll]] for (uint g = 0u; g < GMAX; g++) {
        l[g] = qw[g * 256u];
    }
    barrier();
    [[unroll]] for (uint g = 0u; g < GMAX; g++) {
        qw[g * 256u + t] = e[g];
    }
    barrier();
    if (t < p.hd) {
        float av[GMAX];
        [[unroll]] for (uint g = 0u; g < GMAX; g++) {
            av[g] = 0.0;
        }
        U16s vr = U16s(p.vc + uint64_t(2u * (t0 * p.kv_width + kvh * p.hd + t)));
        // Sixteen positions' values loaded at a time, then summed in order.
        uint nv = K_ONLY == 0u ? nt : 0u;
        uint j = 0u;
        for (; j + 16u <= nv; j += 16u) {
            float v[16];
            [[unroll]] for (uint u = 0u; u < 16u; u++) {
                v[u] = unpackHalf2x16(uint(vr.v[(j + u) * p.kv_width])).x;
            }
            [[unroll]] for (uint u = 0u; u < 16u; u++) {
                [[unroll]] for (uint g = 0u; g < GMAX; g++) {
                    av[g] += qw[g * 256u + j + u] * v[u];
                }
            }
        }
        for (; j < nv; j++) {
            float v = unpackHalf2x16(uint(vr.v[j * p.kv_width])).x;
            [[unroll]] for (uint g = 0u; g < GMAX; g++) {
                av[g] += qw[g * 256u + j] * v;
            }
        }
        [[unroll]] for (uint g = 0u; g < GMAX; g++) {
            if (g < p.group) {
                F32s(p.part + uint64_t(4u * ((h0 + g) * p.n_split + s) * (p.hd + 2u))).v[2u + t] = av[g];
            }
        }
    }
    if (t == 0u) {
        [[unroll]] for (uint g = 0u; g < GMAX; g++) {
            if (g < p.group) {
                F32s dst = F32s(p.part + uint64_t(4u * ((h0 + g) * p.n_split + s) * (p.hd + 2u)));
                dst.v[0] = m[g];
                dst.v[1] = l[g];
            }
        }
    }
}
