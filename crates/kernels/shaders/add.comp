#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// y = a + b: the residual adds. Exact in f32, so it matches its twin bit for bit.
layout(local_size_x = 256) in;
layout(push_constant) uniform Push {
    uint64_t a;
    uint64_t b;
    uint64_t y;
    uint n;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) {
        F32s(p.y).v[i] = F32s(p.a).v[i] + F32s(p.b).v[i];
    }
}
