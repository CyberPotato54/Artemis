#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// The DeltaNet gates: beta = sigmoid(b), g = ssm_a ⊙ softplus(alpha + dt_bias), over n value
// heads, for each token of a batch (workgroup y): b, alpha, beta and g hold [tokens][n]; ssm_a and dt_bias are shared.
layout(local_size_x = 64) in;
layout(push_constant) uniform Push {
    uint64_t b;
    uint64_t alpha;
    uint64_t dt_bias;
    uint64_t a;
    uint64_t beta;
    uint64_t g;
    uint n;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint at = gl_WorkGroupID.y * p.n + i;
    if (i < p.n) {
        F32s(p.beta).v[at] = sigmoid(F32s(p.b).v[at]);
        F32s(p.g).v[at] = F32s(p.a).v[i] * softplus(F32s(p.alpha).v[at] + F32s(p.dt_bias).v[i]);
    }
}
