#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "silu_det.glsl"
#include "quant.glsl"
#include "slots.glsl"
#define RED_ROWS 8u
#define RED_N 32u
#include "reduce.glsl"

// experts_gate_up for up to 16 tokens, each routed expert's weights read once. `list` is moe_unique's:
// workgroup (x, u) computes rows 8x .. 8x + 8 of the u-th distinct expert and dots each unit it loads with every
// token that chose the expert (quant.glsl's unit_dot_n_at), in experts_gate_up's order, so token i's value is
// experts_gate_up's bit for bit. Token i's output goes where decode puts it, y[(i·k + j) · n_ff + row] with j the
// choice of ids[i][0 .. k] that names the expert. A workgroup with u >= count exits (the whole group, before any
// barrier). An unusable slot gives NaN and refuse(), as experts_gate_up does; there is no CPU path (serve) here.
// y[i][j][row] = silu_det(gate·x[i]) · (up·x[i]). Keep silu_det's users together (AGENTS.md): this is the fourth.
layout(local_size_x = 32, local_size_y = 8) in;
layout(push_constant) uniform Push {
    uint64_t table;
    uint64_t ids;
    uint64_t list;
    uint64_t x;
    uint64_t y;
    uint64_t status;
    uint layer_base;
    uint n_embd;
    uint n_ff;
    uint gate_type;
    uint up_type;
    uint up_off;
    uint layer;
    uint k;
} p;

shared uint choice_[MAX_TOKENS];

void main() {
    uint lane = gl_LocalInvocationID.x, r = gl_LocalInvocationID.y;
    uint row = gl_WorkGroupID.x * 8u + r;
    U32s l = U32s(p.list);
    uint u = gl_WorkGroupID.y;
    if (u >= l.v[0]) {
        return;
    }
    uint e = l.v[1u + 2u * u], mask = l.v[2u + 2u * u];
    // Token i's choice j: the first of its k ids that names e (a token's ids are distinct).
    uint flat_id = r * 32u + lane;
    if (flat_id < MAX_TOKENS && ((mask >> flat_id) & 1u) != 0u) {
        uint j = 0u;
        while (j + 1u < p.k && uint(F32s(p.ids).v[flat_id * p.k + j]) != e) {
            j++;
        }
        choice_[flat_id] = j;
    }
    barrier();
    Slot s = slot_at(p.table, p.layer_base + e);
    bool compute = row < p.n_ff && usable(s);
    uint xoff[MAX_TOKENS];
    for (uint i = 0u; i < MAX_TOKENS; i++) {
        xoff[i] = i * p.n_embd;
    }
    precise float g[MAX_TOKENS], up[MAX_TOKENS];
    for (uint i = 0u; i < MAX_TOKENS; i++) {
        g[i] = 0.0;
        up[i] = 0.0;
    }
    if (compute) {
        uint64_t gr = s.addr + uint64_t(row) * uint64_t(row_bytes(p.gate_type, p.n_embd));
        uint64_t ur = s.addr + uint64_t(p.up_off) + uint64_t(row) * uint64_t(row_bytes(p.up_type, p.n_embd));
        for (uint q = lane; q < p.n_embd / 32u; q += 32u) {
            unit_dot_n_at(p.gate_type, gr, q, p.x, xoff, mask, g);
            unit_dot_n_at(p.up_type, ur, q, p.x, xoff, mask, up);
        }
    }
    // The tree reductions hold barriers: every invocation reaches them, token by token in the mask's order.
    for (uint m = mask; m != 0u; m &= m - 1u) {
        uint i = uint(findLSB(m));
        float gs = red_sum(r, lane, g[i]);
        float us = red_sum(r, lane, up[i]);
        if (lane == 0u && row < p.n_ff) {
            uint at = (i * p.k + choice_[i]) * p.n_ff + row;
            if (!usable(s)) {
                refuse(p.status, s, p.layer, e);
                F32s(p.y).v[at] = uintBitsToFloat(0x7FC00000u);
            } else {
                F32s(p.y).v[at] = silu_det(gs) * us;
            }
        }
    }
}
